{
  "manifest_version": 3,
  "name": "Discord Checker",
  "version": "1.0.0",
  "description": "Watch chosen Discord servers and channels, with unread indicators and a toolbar badge. Requires an open Discord web tab.",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://discord.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Discord Checker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://discord.com/*"],
      "js": ["reader.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
